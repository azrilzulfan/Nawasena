<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Izinkan HTTPS ke semua domain (default sudah aman) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
